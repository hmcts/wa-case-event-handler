{
  "timezone": "Europe/London",
  "platformAutomerge": false,
  "automergeSchedule": ["* 9-15 * * 1-5"],
  "minimumReleaseAge": "30 days",
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "labels": [
    "dependencies"
  ],
  "extends": [
    "local>hmcts/.github:renovate-config",
    "local>hmcts/.github//renovate/automerge-minor"
  ],
  "packageRules": [
    {
      "matchPackagePatterns": [
        "serenity",
        "pitest",
        "pact"
      ],
      "enabled": false
    },
    {
      "description": "Exclude HMCTS dependencies from the release age gate",
      "matchPackageNames": [
        "com.github.hmcts*",
        "uk.gov.hmcts*",
        "hmctsprod.azurecr.io/**",
        "hmctspublic.azurecr.io/**"
      ],
      "minimumReleaseAge": null
    }
  ]
}